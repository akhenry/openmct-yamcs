<?xml version="1.0" encoding="UTF-8"?>

<!--
  Overlay SpaceSystem loaded alongside the stock YAMCS QuickStart MDB
  (see tests/patch-quickstart-mdb.sh) so that e2e specs can exercise
  openmct-yamcs features that key off `OpenMCT:*` XTCE aliases. None of
  these parameters need the TM/TC simulator pipeline: they are all
  dataSource="local", meaning they are set directly through the YAMCS
  REST API (or by openmct-yamcs itself) rather than being derived from
  telemetry packets.

  The alias syntax below is based on the example in
  src/providers/mission-status/README.md.
-->
<SpaceSystem name="OpenMCTTest" shortDescription="Open MCT Test Parameters"
  xmlns="http://www.omg.org/spec/XTCE/20180204"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xi="http://www.w3.org/2001/XInclude">

  <LongDescription>
    Parameters that are used for Open MCT e2e testing only. Covers mission
    status, operator status, poll question, imagery, OpenMCT:omit, a plain
    OpenMCT:type override, and telemetry value-type fixtures (boolean, array,
    XTCE units, and a nested aggregate) exercised by valueTypes.e2e.spec.mjs.
  </LongDescription>

  <Header validationStatus="Draft" classification="none" />
  <TelemetryMetaData>
    <ParameterTypeSet>
      <!-- Defines the possible options for all mission actions -->
      <EnumeratedParameterType name="MissionStatusType">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        <EnumerationList>
          <Enumeration value="0" label="NO GO" shortDescription="No Go" />
          <Enumeration value="1" label="GO" shortDescription="Go" />
        </EnumerationList>
      </EnumeratedParameterType>

      <!-- Defines the possible options for all operator status roles -->
      <EnumeratedParameterType name="OperatorStatusType">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
        <EnumerationList>
          <Enumeration value="0" label="OFF DUTY" shortDescription="Off Duty" />
          <Enumeration value="1" label="ON DUTY" shortDescription="On Duty" />
        </EnumerationList>
      </EnumeratedParameterType>

      <StringParameterType name="PollQuestionType">
        <StringDataEncoding encoding="UTF-8">
          <SizeInBits>
            <Fixed>
              <FixedValue>4096</FixedValue>
            </Fixed>
          </SizeInBits>
        </StringDataEncoding>
      </StringParameterType>

      <BinaryParameterType name="ImageType">
        <BinaryDataEncoding>
          <SizeInBits>
            <FixedValue>65536</FixedValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>

      <IntegerParameterType name="OmittedType" signed="false">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
      </IntegerParameterType>

      <IntegerParameterType name="OverriddenType" signed="false">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
      </IntegerParameterType>

      <!-- Value-type coverage fixtures (see valueTypes.e2e.spec.mjs) -->

      <!-- Boolean (#365): VALUE_EXTRACT_MAP.BOOLEAN -> value.booleanValue -->
      <BooleanParameterType name="BooleanValueType" oneStringValue="True" zeroStringValue="False">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned" />
      </BooleanParameterType>

      <!-- Units (#91/#93): object-provider #hasUnit/#getUnit read
           parameter.type.unitSet[].unit and append it to value metadata. -->
      <FloatParameterType name="UnitFloatType" sizeInBits="32">
        <UnitSet>
          <Unit description="degrees Celsius">degC</Unit>
        </UnitSet>
        <FloatDataEncoding sizeInBits="32" encoding="IEEE754_1985" />
      </FloatParameterType>

      <!-- Scalar element type reused by the array and aggregate fixtures. -->
      <FloatParameterType name="ScalarFloatType" sizeInBits="32">
        <FloatDataEncoding sizeInBits="32" encoding="IEEE754_1985" />
      </FloatParameterType>

      <!-- Array (#49/#51/#76/#292): object-provider #isArray checks
           engType.endsWith('[]'); getValue iterates value.arrayValue,
           extracting each element via the scalar VALUE_EXTRACT_MAP. -->
      <ArrayParameterType name="FloatArrayType" arrayTypeRef="ScalarFloatType">
        <DimensionList>
          <Dimension>
            <StartingIndex><FixedValue>0</FixedValue></StartingIndex>
            <EndingIndex><FixedValue>2</FixedValue></EndingIndex>
          </Dimension>
        </DimensionList>
      </ArrayParameterType>

      <!-- Scalar integer element reused by the aggregate fixture. -->
      <IntegerParameterType name="ScalarIntegerType" signed="true">
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement" />
      </IntegerParameterType>

      <!-- Inner aggregate, nested inside NestedAggregateType below. Exercises
           the nested-aggregate-with-members path in object-provider
           #formatAggregateMembers and the nested recursion in utils
           getAggregateValues. (#75) -->
      <AggregateParameterType name="InnerAggregateType">
        <MemberList>
          <Member name="innerScalar" typeRef="ScalarFloatType" />
          <Member name="innerCount" typeRef="ScalarIntegerType" />
        </MemberList>
      </AggregateParameterType>

      <!-- Nested aggregate whose members are (a) a scalar, (b) an array, and
           (c) another aggregate. This is the fixture that drives the array-member
           and nested-aggregate recursion branches. (#75) -->
      <AggregateParameterType name="NestedAggregateType">
        <MemberList>
          <Member name="scalar" typeRef="ScalarFloatType" />
          <Member name="valuesArray" typeRef="FloatArrayType" />
          <Member name="inner" typeRef="InnerAggregateType" />
        </MemberList>
      </AggregateParameterType>
    </ParameterTypeSet>

    <ParameterSet>
      <!-- Mission Status (mission actions) -->
      <Parameter parameterTypeRef="MissionStatusType" name="DrivingStatus">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.missionStatus" />
          <Alias nameSpace="OpenMCT:action" alias="drivingStatus" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>
      <Parameter parameterTypeRef="MissionStatusType" name="DrillingStatus">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.missionStatus" />
          <Alias nameSpace="OpenMCT:action" alias="drillingStatus" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>
      <Parameter parameterTypeRef="MissionStatusType" name="ImageryStatus">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.missionStatus" />
          <Alias nameSpace="OpenMCT:action" alias="imageryStatus" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Operator Status (roles) -->
      <Parameter parameterTypeRef="OperatorStatusType" name="FlightOperatorStatus">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.operatorStatus" />
          <Alias nameSpace="OpenMCT:role" alias="Flight" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>
      <Parameter parameterTypeRef="OperatorStatusType" name="ScienceOperatorStatus">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.operatorStatus" />
          <Alias nameSpace="OpenMCT:role" alias="Science" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Poll Question -->
      <Parameter parameterTypeRef="PollQuestionType" name="PollQuestion">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.pollQuestion" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Imagery -->
      <Parameter parameterTypeRef="ImageType" name="TestImage">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.image" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- OpenMCT:omit -->
      <Parameter parameterTypeRef="OmittedType" name="OmittedParameter">
        <AliasSet>
          <Alias nameSpace="OpenMCT:omit" alias="true" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Boolean value type (#365) -->
      <Parameter parameterTypeRef="BooleanValueType" name="BooleanValue">
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Numeric parameter carrying a unit (#91/#93) -->
      <Parameter parameterTypeRef="UnitFloatType" name="UnitFloat">
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Array value type (#49/#51/#76/#292) -->
      <Parameter parameterTypeRef="FloatArrayType" name="FloatArray">
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Nested aggregate value type (#75) -->
      <Parameter parameterTypeRef="NestedAggregateType" name="NestedAggregate">
        <ParameterProperties dataSource="local" />
      </Parameter>

      <!-- Plain OpenMCT:type override (not one of the special-cased types) -->
      <Parameter parameterTypeRef="OverriddenType" name="OverriddenParameter">
        <AliasSet>
          <Alias nameSpace="OpenMCT:type" alias="yamcs.string" />
        </AliasSet>
        <ParameterProperties dataSource="local" />
      </Parameter>
    </ParameterSet>
  </TelemetryMetaData>
</SpaceSystem>
